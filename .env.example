# Copy this file, rename the copy to ".env" (in this same fitflow/ folder),
# and fill in your own values. Never commit the real .env file.

# MongoDB connection string
# Local MongoDB:  mongodb://127.0.0.1:27017/fitflow
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitflow
MONGO_URI=

# Any long random text. Used to sign login tokens (JWT).
JWT_SECRET=

# Port the backend (Express) runs on
PORT=5000
